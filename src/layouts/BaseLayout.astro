---
import { Font } from "astro:assets"

import "../styles/globals.css"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import Navigation from "../components/Navigation.astro"

const { renderHome } = Astro.props;
---
<html lang="en">
	<slot name="head"/>
	
	<body>
		<section>
			<Header/>

			<Navigation renderHome={renderHome}/>

            <slot/>

			<Footer/>
		</section>
	</body>

	<style>
		section {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
	
			margin: 0;

			width: 100svw;
			height: 100svh;
			overflow-y: scroll;
			
			background: var(--main-color);
		}
	</style>
</html>
