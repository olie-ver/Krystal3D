---
import Sun from "../images/Sun.svg";
import Moon from "../images/Moon.svg";
import Crescent from "../images/Crescent.svg";
import Night from "../images/Night.svg";

const { page } = Astro.props;
---

<header>
    <p>{page}</p>
    <img id="themeToggle" class="display" src={Sun.src}
        alt="Theme toggle button"/>
</header>

<style>
header {
    position: relative;
    display: flex;
    top: 0;
    left: 0;
    right: 0;

    width: 100%;
    height: max(6svh, 4svw);
    border-bottom: 3px solid var(--border-color);
    margin-bottom: 1svh;
    padding-top: 1svh;
    padding-bottom: 0.5svh;

    background-color: var(--background-color);
}

header p {
    position: absolute;
    top: -3rem;
    left: 2%;
    font-family: var(--font-tilt-prism);
    font-size: 3rem;
    color: white;
    cursor: pointer;
}

header img {
    position: absolute;
    right: 2%;
    height: inherit; 
    cursor: pointer;
}
</style>

<script is:inline define:vars={{Sun, Moon, Crescent, Night}}>
const theme = (() => {
    const localStorageTheme = localStorage?.getItem("theme") ?? "";
    if (["light", "dark", "darker", "midnight"].includes(localStorageTheme)) {
        return localStorageTheme;
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        return "darker";
    }
    return "light";
})();

document.documentElement.className = theme;

switch (theme) {
    case "light":
        document.getElementById("themeToggle")?.setAttribute("src", Sun.src);
        break;
    case "dark":
        document.getElementById("themeToggle")?.setAttribute("src", Moon.src);
        break;
    case "darker":
        document.getElementById("themeToggle")?.setAttribute("src", Crescent.src);
        break;
    case "midnight":
        document.getElementById("themeToggle")?.setAttribute("src", Night.src);
        break;
}

const handleToggleClick = () => {
    const element = document.documentElement;

    const oldTheme = localStorage.getItem("theme")?.toLowerCase() ?? "light";
    let src = "src/images/Sun.svg";
    switch (oldTheme) {
        case "light":
            element.className = "dark";
            localStorage.setItem("theme", "dark");
            src = Moon.src;
            break;
        case "dark":
            element.className = "darker";
            localStorage.setItem("theme", "darker");
            src = Crescent.src;
            break;
        case "darker":
            element.className = "midnight";
            localStorage.setItem("theme", "midnight");
            src = Night.src;
            break;
        case "midnight":
            element.className = "light";
            localStorage.setItem("theme", "light");
            src = Sun.src;
            break;
    }

    document.getElementById("themeToggle")?.setAttribute("src", src);
}

document.getElementById("themeToggle")?.addEventListener("click", handleToggleClick);
</script>