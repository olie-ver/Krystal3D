---
const { doc, path } = Astro.props;

---

<div class="Card">
    <a href={`/docs/${doc.parent}/${path}/`}><h1>{doc.title}</h1></a>
    <p>{doc.desc}</p>
    <p>Version: {doc.version}</p>
    <p>Last Updated: {doc.lastUpdated.toString().substring(0, 10)}</p>
</div>

<style>
.Card {
    display: flex;
    flex-direction: column;
    border-radius: 25px;
    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);

    width: 80%;
    height: fit-content;
    background: transparent;
    margin-bottom: 5svh;
}

img {
    align-self: center;
    margin-top: 2.5%;
    margin-bottom: 2.5%;

    aspect-ratio: 1 / 1;
    object-fit: cover;
    align-self: center;

    width: 40%;
    max-width: 50%;
}

#svg {
    filter: var(--logo-filter);
}

#img {
    filter: var(--image-brightness);
}

.Info {
    width: 100%;
    border-top: 3px solid var(--card-border-color);
}

p {
    margin-left: 5%;
    margin-right: 5%;
    text-align: center;
}

h1 {
    text-align: center;
}

@media (orientation: landscape) {
    .Card {
        width: 100%;
        height: 100%;
        margin-bottom: 0;
    }
}
</style>