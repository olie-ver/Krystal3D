---
export const prerender = true;

import Logo from "../images/Krystal.svg"
---

<img class="logo" src={Logo.src} alt="Krystal logo"/>

<style>
img {
    position: relative;
    margin-left: env(safe-area-inset-left);
    aspect-ratio: 1 / 1;
    object-fit: cover;

    filter: var(--logo-filter);

    width: max(10svw, 12svh);
}
</style>