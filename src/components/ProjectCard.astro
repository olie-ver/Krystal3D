---
const { project } = Astro.props;
console.log(project);
---

<div class="Card">
    <img src={project.img.src} alt={project.img.alt}/>
    <div class="Info">
        <h1>{project.title}</h1>
        <p>Status: {project.status}</p>
        <p>Version: {project.version}</p>
        <p>Open Source: {project["open-source"]}</p>
        <p>License: {project.license}</p>
        <p>Contributors: 
            {
                " " + project.contributors.join(", ")
            }
        </p>
        <p> 
            Start Date: {project["start-date"].toString().substring(0, 10)}. 
            <!-- Last Updated: {project["last-updated"].toString().substring(0, 10)} -->
        </p>
    </div>
</div>
<style>
.Card {
    display: flex;
    flex-direction: column;
    border-radius: 25px;
    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);

    width: 80%;
    height: fit-content;
    background: transparent;
    margin-bottom: 5svh;
}

img {
    margin-top: 2.5%;
    margin-bottom: 2.5%;
    align-self: center;
    max-width: 50%;
}

.Info {
    width: 100%;
    border-top: 3px solid lightgray;
}

p {
    margin-left: 5%;
}

h1 {
    text-align: center;
}
</style>