---
const { project } = Astro.props;
---

<div class="Card">
    <img id={project.svg ? "svg" : "img"} src={project.img.src.src} alt={project.img.alt}/>

    <div class="Info">
        <a href={`/projects/${project.title}`}><h1>{project.title}</h1></a>
        <p>Status: {project.status}</p>
        <p>Version: {project.version}</p>
        <p>Open Source: {project.openSource}</p>
        <p>License: {project.license}</p>
        <p>Contributors: 
            {
                " " + project.contributors.join(", ")
            }
        </p>
        <p>Start Date: {project.startDate.toString().substring(0, 10)}</p>
        <p>Last Updated: {project.lastUpdated.toString().substring(0, 10)}</p>
    </div>
</div>
<style>
.Card {
    display: flex;
    flex-direction: column;
    border-radius: 25px;
    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);

    width: 80%;
    height: fit-content;
    background: transparent;
    margin-bottom: 5svh;
}

img {
    align-self: center;
    margin-top: 2.5%;
    margin-bottom: 2.5%;

    aspect-ratio: 1 / 1;
    object-fit: cover;
    align-self: center;

    width: 40%;
    max-width: 50%;
}

#svg {
    filter: var(--logo-filter);
}

#img {
    filter: var(--image-brightness);
}

.Info {
    width: 100%;
    border-top: 3px solid var(--card-border-color);
}

p {
    margin-left: 5%;
}

h1 {
    text-align: center;
}

@media (orientation: landscape) {
    .Card {
        width: 100%;
        height: 100%;
        margin-bottom: 0;
    }
}
</style>