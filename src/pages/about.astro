---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Head from '../components/Head.astro';
import Member from "../components/Member.astro"

import { getCollection } from "astro:content";

const allMembers = await getCollection("members");
---

<BaseLayout renderHome={true}>
    <Head slot="head"
        title="Krystal - About Us"
        description="Krystal's about us page. Learn more about the people behind Krystal's projects,
            what we stand for, and what we do."
        keywords="krystal, krystal3d, about krystal, about krystal3d, krystal about page, krystal3d about page"
    />
    <main>
        <h1>About Us</h1>
        <p>Here are the people who run Krystal and make it all happen.</p>

        <div id="content">
            {
                allMembers.map((member: any) => (
                    <Member member={member.data} />
                ))
            }
        </div>
    </main>
</BaseLayout>

<style>
    h1, h3, p {
        text-align: center;
        margin-left: 10%;
        max-width: 80%;
    }

    #content {
        width: 100%;
        height: fit-content;
        text-align: center;
        margin: 0;
        overflow: auto;
        border-radius: 0%;
    }

    @media (orientation: landscape) {
        h1, p, #content {
            margin-left: calc(10% + env(safe-area-inset-left));
            width: calc(80% - env(safe-area-inset-left));
        }

        h1 {
            font-size: 2rem;
        }
    }
</style>