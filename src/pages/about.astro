---
import BaseLayout from "../layouts/BaseLayout.astro";
import Member from "../components/Member.astro"

import { getCollection } from "astro:content";

const allMembers = await getCollection("members");
console.log(allMembers);
---
<BaseLayout renderHome={true}>
    <main>
        <h1>About Us</h1>
        <p>Here are the people who run Krystal and make it all happen.</p>

        <div id="content">
            {
                allMembers.map((member: any) => (
                    <Member member={member.data} />
                ))
            }
        </div>
    </main>
</BaseLayout>

<style>
    h1, h3, p {
        text-align: center;
        margin-left: 10%;
        max-width: 80%;
    }

    #content {
        width: 100%;
        height: fit-content;
        margin: 0;
        overflow: auto;
        border-radius: 0%;
    }

    @media (orientation: landscape) {
        h1, p, #content {
            margin-left: calc(10% + env(safe-area-inset-left));
            width: calc(80% - env(safe-area-inset-left));
        }

        h1 {
            font-size: 2rem;
        }

        #content {
            display: flex;
			gap: 10svh 5%;

            width: calc(80% - env(safe-area-inset-left));
        }
    }
</style>