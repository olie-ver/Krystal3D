---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro"
import Head from "../../components/Head.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
---

<BaseLayout renderHome={true}>
	<Head slot="head"
        title="Krystal - Projects"
        description="View the projects we have built and maintain. Check back here for updates 
			on any projects including updates, revisions, or new releases."
        keywords="krystal, krystal3d, krystal projects, krystal3d projects"
    />
	<main>
		{
			allProjects.map((project: any) => (
				<ProjectCard project={project.data} />
			))
		}
	</main>
	<style>
		main {
			display: flex;
			flex-direction: column;
			align-items: center;

			width: 100%;
		}

		@media (orientation: landscape) {
			main {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 10svh 5%;

				margin-left: calc(10% + env(safe-area-inset-left));
				margin-bottom: 5svh;

				width: calc(80% - env(safe-area-inset-left));
			}
		}
	</style>
</BaseLayout>