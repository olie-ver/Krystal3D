---
export const prerender = true;

import { getCollection, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import PaymentForm from "../../components/PaymentForm.astro";

import "../../styles/project.css"

export async function getStaticPaths() {
    const allProjects = await getCollection("projects");
    return allProjects.map((project) => 
    (
        {   
            params: { 
                project: project.data.title, 
            },
            props: {
                p: project
            }
        }
    ));
}

const { project } = Astro.params;
const { p } = Astro.props;
const { Content } = await render(p);
---

<BaseLayout renderHome={true}>
    <main>
        <h1>{project}</h1>

        <section>
            <img id={p.data.svg ? "svg" : "img"} src={p.data.img.src.src} alt={p.data.img.alt}/>
            <div>
                <p>Status: {p.data.status}</p>
                <p id="middle">Version: {p.data.version}</p>
                <p>License: {p.data.license}</p>
            </div>
        </section>

        <article>
            <Content/>
        </article>

        <input id="show-form" type="checkbox"/>
        <label for="show-form">Click to Support</label>
        <span>
            <PaymentForm reason={project}/>
        </span>
    </main>
</BaseLayout>
<style>
    #show-form, span {
        display: none;
    }

    #show-from, #show-form~label {
        align-self: center;
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 3svh;
    }

    #show-form~label {
        cursor: pointer;
        color: var(--text-color);
    }

    #show-form:checked~span {
        display:block;
    }

    main {
        display: flex;
        flex-direction: column;

        border-radius: 25px;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);

        margin: 2.5%;
        width: 95%;
        height: fit-content;
        background: transparent;
        margin-bottom: 5svh;
    }

    h1 {
        margin-top: 5%;
        font-size: 2rem;
    }

    article {
        width: 90%;
        padding-bottom: 5%;
        line-height: 1.7;
        align-self: center;
    }

    article h2 {
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.4rem;

        font-size: 1.6rem;
        border-bottom: 2px solid var(--card-border-color);
    }

    article h3 {
        margin-top: 2rem;
        margin-bottom: 0.75rem;

        font-size: 1.25rem;
    }

    article p {
        margin: 0 0 1rem;
    }

    ul, ol {
        color: var(--text-color);
    }

    article ul,
    article ol {
        margin: 0.75rem 0 1.25rem;
        padding-left: 1.75rem;
    }

    article li {
        margin-bottom: 0.6rem;
    }

    article li::marker {
        font-weight: bold;
    }

    article code {
        padding: 0.15rem 0.35rem;

        border-radius: 5px;
        background: var(--card-border-color);

        font-family: monospace;
        font-size: 0.9em;
    }

    article pre {
        box-sizing: border-box;

        margin: 1.5rem 0;
        padding: 1rem 1.25rem;

        overflow-x: auto;

        border-radius: 10px;
        background: #1e1e1e;

        text-align: center;
        line-height: 1.5;
    }

    article pre code {
        padding: 0;

        background: transparent;

        font-size: 0.9rem;
        white-space: pre;
    }

    article a {
        font-weight: 500;
    }

    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    img {
        max-width: 40%;
        margin-bottom: 5%;
    }

    #svg {
        filter: var(--logo-filter);
    }

    #img {
        filter: var(--image-brightness);
    }

    div {
        display: grid;
        grid-template-columns: auto auto auto;

        width: 90%;
        margin: 0% 5% 5% 5%;
        border-top: 3px solid var(--card-border-color);
        border-bottom: 3px solid var(--card-border-color);

        text-align: center;
    }

    #middle {
        border-left: 3px solid var(--card-border-color);
        border-right: 3px solid var(--card-border-color);
    }

    article a {
        align-self: center;
        background-color: orange;
    }

    @media (orientation: landscape) {
        main {
            margin-left: calc(10% + env(safe-area-inset-left));
			margin-bottom: 5svh;

            width: calc(80% - env(safe-area-inset-left));
        }

        img {
            max-width: 30%;
        }

        article {
            max-width: 80%;
        }
    }
</style>