---
import { getCollection, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/project.css"

export async function getStaticPaths() {
    const allProjects = await getCollection("projects");
    return allProjects.map((project) => 
    (
        {   
            params: { 
                project: project.data.title, 
            },
            props: {
                p: project
            }
        }
    ));
}

const { project } = Astro.params;
const { p } = Astro.props;
const { Content } = await render(p);
---

<BaseLayout>
    <main>
        <h1>{project}</h1>

        <section>
            <img id={p.data.svg ? "svg" : "img"} src={p.data.img.src.src} alt={p.data.img.alt}/>
            <div>
                <p>Status: {p.data.status}</p>
                <p id="middle">Version: {p.data.version}</p>
                <p>License: {p.data.license}</p>
            </div>
        </section>

        <article>
            <Content/>
        </article>
    </main>
</BaseLayout>
<style>
    main {
        display: flex;
        flex-direction: column;
        align-items: center;

        border-radius: 25px;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);

        margin: 2.5%;
        width: 95%;
        height: fit-content;
        background: transparent;
        margin-bottom: 5svh;
    }

    h1 {
        margin-top: 5%;
    }

    article {
        padding-bottom: 5%;
    }

    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    img {
        max-width: 40%;
        margin-bottom: 5%;
    }

    #svg {
        filter: var(--logo-filter);
    }

    #img {
        filter: var(--image-brightness);
    }

    div {
        display: grid;
        grid-template-columns: auto auto auto;

        width: 90%;
        margin: 0% 5% 5% 5%;
        border-top: 3px solid var(--card-border-color);
        border-bottom: 3px solid var(--card-border-color);

        text-align: center;
    }

    #middle {
        border-left: 3px solid var(--card-border-color);
        border-right: 3px solid var(--card-border-color);
    }
</style>