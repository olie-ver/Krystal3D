---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Head from "../../components/Head.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import { getEntry } from "astro:content";

const allProjects = await getEntry("projects", "test");
---

<BaseLayout renderHome={true}>
    <Head slot="head"
        title="Krystal - Docs"
        description="Krystal's documentation page. Look here for documentation, tutorials, and more
            on our projects."
        keywords="krystal, krystal3d, krystal docs, krystal3d docs, test++ docs, testpp docs, 
            test++ documentation, testpp documentation"
    />

    <main>
		{
            <ProjectCard project={allProjects!.data} doc="true"/>
		}
	</main>
</BaseLayout>

<style>
main {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: 100%;
}

@media (orientation: landscape) {
    main {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10svh 5%;

        margin-left: calc(10% + env(safe-area-inset-left));
        margin-bottom: 5svh;

        width: calc(80% - env(safe-area-inset-left));
    }
}
</style>